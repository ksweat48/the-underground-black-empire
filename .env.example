# The Underground Black Empire — Environment Variables

# Supabase (pre-populated in Bolt environment; do not modify unless you know why)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Secret keys (SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL) must NEVER
# be exposed in client-side environment variables. They are only used in
# edge functions and server-side code.
